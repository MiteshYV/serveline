{
  "name": "serveline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types src/db/migrate.ts",
    "db:seed": "NODE_ENV=${NODE_ENV:-development} node --experimental-strip-types src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "eval": "node --experimental-strip-types src/voice/eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@electric-sql/pglite": "^0.5.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0"
  }
}
