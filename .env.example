# Local development needs none of these set. PGlite and the mock adapters are the defaults.

# --- data ---
DATABASE_URL=file://./data/serveline.pglite   # a postgres:// URL in staging and production

# --- vendors ---
# mock  = no account needed, everything runs locally  (the M1 default)
# live  = real vendors; every variable below must then be set
VENDOR_MODE=mock

# --- secrets (generate with: openssl rand -hex 32) ---
PHONE_HASH_PEPPER=
SESSION_SECRET=

# --- payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- sms (Exotel, MSG91 fallback) ---
SMS_PROVIDER=
SMS_API_KEY=
DLT_ENTITY_ID=
DLT_HEADER=

# --- storage ---
AWS_REGION=ap-south-1
S3_BUCKET_ASSETS=

# --- llm (M2: the call assistant's brain) ---
# gemini | anthropic | mock. With VENDOR_MODE=mock and nothing set, both fall back to the scripted
# mock, which drives every flow without a key. A provider named here must have its key set.
LLM_PRIMARY_PROVIDER=mock
LLM_PRIMARY_API_KEY=            # Gemini: aistudio.google.com → API key
# GEMINI_MODEL=                 # overrides the measured default (ADR 0006) when Google moves again

# A model on this machine, through Ollama — the offline demo, not the default: measured at 15.7s a
# turn against the hosted model's 2.9s (ADR 0007). LLM_PRIMARY_PROVIDER=ollama selects it.
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_HOST=http://127.0.0.1:11434
LLM_SECONDARY_PROVIDER=mock
LLM_SECONDARY_API_KEY=          # Anthropic: console.anthropic.com; model claude-haiku-4-5

# --- voice API: the future Python/Exotel transport authenticates with this header token ---
# Unset = the token path is disabled; the browser transport uses the customer session instead.
VOICE_SERVICE_TOKEN=

# --- speech to text (src/adapters/stt, ADR 0007) ---
# Unset + VENDOR_MODE=mock -> the scripted mock: the browser's own recogniser supplies the words
# and everything else on the path runs for real. Unset + live -> an error, never a quiet mock.
#
#   whisper  a whisper.cpp server on this machine. No account, no per-minute price, and the audio
#            never leaves the building — the strongest answer to Build Spec §10's residency rule.
#            Start one first, or every clip 502s:
#              whisper-server -m models/ggml-large-v3-turbo-q5_0.bin --host 127.0.0.1 --port 8080
#   sarvam   Build Spec §3's vendor. Written, never run: there is no account yet.
STT_PROVIDER=mock
# WHISPER_HOST=http://127.0.0.1:8080
# WHISPER_MODEL=large-v3-turbo

# --- M2b, when accounts exist: telephony ---
# EXOTEL_SID= EXOTEL_API_KEY= EXOTEL_API_TOKEN= EXOTEL_SUBDOMAIN=
# SARVAM_API_KEY=      # with STT_PROVIDER=sarvam; SARVAM_MODEL overrides saarika:v2
