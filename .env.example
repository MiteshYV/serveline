# Local development needs none of these set. PGlite and the mock adapters are the defaults.

# --- data ---
DATABASE_URL=file://./data/serveline.pglite   # a postgres:// URL in staging and production

# --- vendors ---
# mock  = no account needed, everything runs locally  (the M1 default)
# live  = real vendors; every variable below must then be set
VENDOR_MODE=mock

# --- secrets (generate with: openssl rand -hex 32) ---
PHONE_HASH_PEPPER=
SESSION_SECRET=

# --- payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- sms (Exotel, MSG91 fallback) ---
SMS_PROVIDER=
SMS_API_KEY=
DLT_ENTITY_ID=
DLT_HEADER=

# --- storage ---
AWS_REGION=ap-south-1
S3_BUCKET_ASSETS=

# --- llm ---
LLM_PRIMARY_PROVIDER=
LLM_PRIMARY_API_KEY=
LLM_SECONDARY_PROVIDER=
LLM_SECONDARY_API_KEY=

# --- M2 and later: telephony and speech ---
# EXOTEL_SID= EXOTEL_API_KEY= EXOTEL_API_TOKEN= EXOTEL_SUBDOMAIN=
# SARVAM_API_KEY= VOICE_SERVICE_TOKEN=
